# Copy to profiles.yml (git-ignored) and pick a target with `--target`.
dbt_decisions_integration_tests:
  target: duckdb
  outputs:
    duckdb:
      type: duckdb
      path: dbt_decisions_integration_tests.duckdb
      threads: 4
      # jev needs DuckDB 1.5.5 or 1.5.6. With dbt v2, install a system driver: dbc install "duckdb=1.5.6"
    postgres:
      type: postgres
      host: localhost
      port: 5433
      user: postgres
      password: "{{ env_var('PGPASSWORD', 'decisions-it-placeholder') }}"
      dbname: dbt
      schema: dbt_decisions_integration_tests
    databricks:
      type: databricks
      host: "{{ env_var('DBT_DATABRICKS_HOST_NAME') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH') }}"
      # Browser login (U2M). For a token instead: `token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"`.
      auth_type: oauth
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG', 'main') }}"
      schema: dbt_decisions_integration_tests
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_DEV_ACCOUNT') }}"
      warehouse: "{{ env_var('SNOWFLAKE_DEV_WAREHOUSE') }}"
      role: "{{ env_var('SNOWFLAKE_DEV_ROLE') }}"
      database: "{{ env_var('SNOWFLAKE_DEV_DATABASE') }}"
      schema: dbt_decisions_integration_tests
      user: "{{ env_var('SNOWFLAKE_DEV_USER') }}"
      authenticator: externalbrowser
    bigquery:
      type: bigquery
      method: oauth
      project: "{{ env_var('DBT_BIGQUERY_PROJECT') }}"
      dataset: dbt_decisions_integration_tests
      location: US
