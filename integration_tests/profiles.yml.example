# Copy to profiles.yml (git-ignored).
dbt_decisions_integration_tests:
  target: dev
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DBT_DATABRICKS_HOST_NAME') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH') }}"
      # Browser login (U2M). For a token instead: `token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"`.
      auth_type: oauth
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG', 'main') }}"
      schema: dbt_decisions_integration_tests
      threads: 4
